# Copy to deploy.env. deploy.env is gitignored. Do not commit real values.
# These are names and placeholders. This file is not a running host.
#
# APP_ENV=production refuses the local password "inbox", a database URL without
# sslmode=require (or verify-ca / verify-full), a Redis URL with no password,
# http origins, CORS "*", and a short GRAPH_WEBHOOK_CLIENT_STATE.

APP_ENV=production
LOG_LEVEL=INFO

# openssl rand -hex 32
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Direct Postgres host, not a transaction-pooler host. Neon free is a candidate.
# Change the scheme from postgresql:// to postgresql+psycopg:// and keep sslmode.
# postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
DATABASE_URL=

# redis:// or rediss://. rediss:// turns on TLS. Include a password.
# rediss://:PASSWORD@HOST:6379/0
REDIS_URL=

# Exact browser origin. Production value for this product is the line below.
FRONTEND_URL=https://redocu.app
CORS_ORIGINS=https://redocu.app

# Public API origin is unknown until the host assigns it. A free web service
# can use https://<name>.onrender.com before any custom domain exists.
# https://<API_ORIGIN>/auth/microsoft/callback
GRAPH_REDIRECT_URI=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=common
GRAPH_SCOPES=https://graph.microsoft.com/User.Read,https://graph.microsoft.com/Mail.Read,https://graph.microsoft.com/Mail.ReadWrite
# openssl rand -hex 32
GRAPH_WEBHOOK_CLIENT_STATE=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

LLM_PROVIDER=stub
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
