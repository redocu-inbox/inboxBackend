# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# .env is gitignored. Put real secrets there later; these values are for local dev only.
# A public host uses deploy.env.example instead. Do not copy these passwords there.

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Signs login tokens. Outside APP_ENV=development the API refuses to start with
# this placeholder. Generate a real one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts Microsoft tokens in the database. Required before a mailbox can be
# connected, including in development, and required at startup outside
# development. Losing it means every mailbox has to reconnect. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Postgres (must match POSTGRES_* below).
# The hostname `postgres` is the Docker Compose service name. It only resolves
# inside the compose network. From your machine, use localhost and port 5433
# (published in docker-compose.yml). Port 5432 below is the port inside Docker.
POSTGRES_USER=inbox
POSTGRES_PASSWORD=inbox
POSTGRES_DB=inbox
DATABASE_URL=postgresql+psycopg://inbox:inbox@postgres:5432/inbox

# Redis. Hostname `redis` works the same way as `postgres` above.
# From your machine the published port is 6380, not 6379.
REDIS_URL=redis://redis:6379/0

# Browser origins allowed to call the API. Comma-separated, no spaces required.
# Exact scheme + host + port. Do not use *. Local dev allows both of these.
# Production for the live SPA is one origin and nothing else:
#   CORS_ORIGINS=https://redocu.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origin only, no path, query, userinfo, or whitespace. The Microsoft callback
# redirects the browser to {FRONTEND_URL}/inbox. This is server configuration,
# not a value taken from the request. Local default is the Vite dev server.
# Production:
#   FRONTEND_URL=https://redocu.app
FRONTEND_URL=http://localhost:5173

# local now; s3 / r2 can be added later without changing callers.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

# Microsoft Graph app registration. Fill these in to connect a mailbox.
# Register this redirect on the Entra app as a Web platform redirect, exact
# string, no trailing slash. Local Compose:
#   GRAPH_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# Production, once the API's public HTTPS host is known (it is not in this repo):
#   GRAPH_REDIRECT_URI=https://<API_ORIGIN>/auth/microsoft/callback
# Do not register https://redocu.app as the redirect URI. That host is FRONTEND_URL.
# `consumers` is personal Microsoft accounts. A work or school mailbox can use
# its tenant id, or `common`. If GRAPH_TENANT_ID is unset, the code default is `common`.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=consumers
GRAPH_REDIRECT_URI=
GRAPH_SCOPES=https://graph.microsoft.com/User.Read,https://graph.microsoft.com/Mail.Read,https://graph.microsoft.com/Mail.ReadWrite,https://graph.microsoft.com/Mail.Send
# Public HTTPS URL Graph calls for inbox change notifications. Empty skips
# creating a subscription. Local development can leave this empty and use
# POST /messages/sync.
GRAPH_WEBHOOK_URL=
# Shared secret Graph echoes on each notification. Set a long random string
# before this URL is reachable from the internet. Empty matches an empty clientState.
GRAPH_WEBHOOK_CLIENT_STATE=


# Google OAuth client. Register this redirect on the Google client as an
# authorized redirect URI, exact string, no trailing slash. Local Compose:
#   GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Production. The host is the API, not https://redocu.app (FRONTEND_URL)
#   GOOGLE_REDIRECT_URI=https://redocu-api.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Slack user token. Leave these empty to disable Slack. Outlook and Gmail keep working.
# Register this exact redirect on the Slack app (user token, not a bot token):
#   local: http://localhost:8000/auth/slack/callback
#   production: https://redocu-api.onrender.com/auth/slack/callback
# User scopes are fixed in code: im:history, im:read, mpim:history, mpim:read,
# channels:history, channels:read, groups:history, groups:read, users:read, chat:write.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# 1 (default) allows explicit send from the inbox. 0 refuses chat.postMessage.
SLACK_SEND_ENABLED=1

# Password reset mail. fake stores nothing durable and does not call a provider.
# production refuses fake and console. Use resend or disabled.
# EMAIL_FROM example: redocu <no-reply@redocu.app>
# Resend requires the from-domain to be verified in that account before mail delivers.
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_FROM=

# Server-side Stripe key for cleanup of linked customers. Use a sandbox key in development.
STRIPE_SECRET_KEY=
# 0 ignores X-Forwarded-For. Set to the number of proxies you run in front of the API.
FORWARDED_FOR_HOPS=0

# Worker startup rescores stored mail for every connected mailbox.
# 1 is the default. Set 0 to skip. This does not call Graph, Gmail, or an LLM.
RESCORE_ON_STARTUP=1

# Calendar date for today, tomorrow, weekdays, and due or overdue. Default US Eastern.
SCORING_TIMEZONE=America/New_York

# Periodic sync of every connected Outlook and Gmail mailbox. 1 is the default.
# Set 0 to skip. Interval is minutes, 1 through 60. The free Render service
# sleeps after inactivity, so this cron runs only while the service is awake.
PERIODIC_MAILBOX_SYNC=1
MAILBOX_SYNC_INTERVAL_MINUTES=5

# On-demand form match starts from POST /forms/jobs. 0 is the default.
# A mailbox sync does not enqueue a match, including when this is 1.
FORM_MATCH_ON_SYNC=0

# Reply drafts, AI compose, and form extraction default to the local stub.
# To opt in to Claude, set LLM_PROVIDER=anthropic and supply ANTHROPIC_API_KEY.
# Select an active Claude API model with LLM_MODEL.
LLM_PROVIDER=stub
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
